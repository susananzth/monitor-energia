# Copia este archivo como .env y ajusta los valores.

# Base de datos (PostgreSQL)
POSTGRES_DB=monitor_energia
POSTGRES_USER=monitor
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_PORT=5432

# Primer administrador de la web (solo se crea si no hay usuarios). Cambia la clave al entrar.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-clave-admin

# Puertos y URLs (docker compose up)
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Orígenes que el backend deja pasar (CORS): donde se sirve el frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# URL del backend vista desde el navegador (se fija al construir el frontend)
VITE_API_URL=http://localhost:8080/api/v1
VITE_ENCUESTA_URL=
