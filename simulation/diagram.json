{
  "version": 1,
  "author": "monitor-energia",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "chip-ct-sim",
      "id": "ct1",
      "top": 48,
      "left": -192,
      "attrs": { "irms": "0.45", "vbias": "1.32", "rb": "47", "ns": "2000", "freq": "60" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": 172,
      "left": -192,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 30,
      "left": 190,
      "attrs": { "color": "green", "label": "Wi-Fi / envío" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 110,
      "left": 160,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ct1:OUT", "esp:34", "orange", [] ],
    [ "ct1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:35", "purple", [] ],
    [ "esp:2", "r1:1", "green", [] ],
    [ "r1:2", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
